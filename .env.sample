# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
# Format: sk-proj-... (starts with sk-proj-)
OPENAI_API_KEY=sk-proj-your-actual-key-here

# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
# Format: AIza... (long alphanumeric string)
GOOGLE_API_KEY=AIza-your-actual-key-here

# Flask Configuration (Optional - defaults are sensible)
# Set to 'development' for debugging, 'production' for deployment
FLASK_ENV=development

# Database/Data Paths (Optional - defaults use relative paths)
# If you need custom data locations, set these:
# DATA_DIR=./data
# FAISS_INDEX_PATH=./faiss_vectorstore_recipes

# OpenAI Vision Model (Optional - defaults to gpt-4.1)
# OPENAI_VISION_MODEL=gpt-4-vision

# Gemini Model (Optional - defaults to gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash-lite

# HTTP Client Configuration (Optional)
# Set to false for SSL verification (not recommended in production)
# HTTP_VERIFY_SSL=true
